{
	"name": "backcourt/wc-cart-block-iapi",
	"description": "Cart Block with Interactivity API -- Experimental",
	"homepage": "https://github.com/backcourt/wc-cart-block-iapi",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "helgatheviking",
			"email": "507025+helgatheviking@users.noreply.github.com"
		}
	],
	"autoload": {
		"psr-4": {
			"Backcourt\\WcCartBlock\\iAPI\\": "includes/"
		}
	},
	"support": {
		"issues": "https://github.com/backcourt/wc-cart-block-iapi/issues",
		"source": "https://github.com/backcourt/wc-cart-block-iapi"
	},
	"require-dev": {
		"woocommerce/woocommerce-sniffs": "^1.0",
		"wp-cli/i18n-command": "^2.6"
	},
	"scripts": {
		"makepot-audit": [
			"./vendor/bin/wp --allow-root i18n make-pot . languages/wc-cart-block-iapi.pot --slug=wc-cart-block-iapi --exclude=\".github,.wordpress-org,build,deploy,node_modules,packages,vendor\" --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/backcourt/wc-cart-block-iapi/new\"}'"
		],
		"makepot": [
			"@makepot-audit --skip-audit"
		],
		"phpcs": [
			"phpcs . -s -p -n"
		],
		"phpcs-pre-commit": [
			"phpcs . -s -p -n"
		],
		"phpcb": [
			"phpcbf . "
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"extra": {
		"scripts-description": {
			"makepot": "Generate a .pot file for translation",
			"makepot-audit": "Generate a .pot file for translation. Dry run.",
			"phpcs": "Analyze code against the WordPress coding standards with PHP_CodeSniffer",
			"phpcb": "Fix coding standards warnings/errors automatically with PHP Code Beautifier"
		}
	}
}
