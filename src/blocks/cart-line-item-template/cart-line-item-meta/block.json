{
	"name": "woocommerce/cart-line-item-meta",
	"version": "1.0.0",
	"title": "Cart Line Item Meta",
	"description": "Block containing product meta for cart item.",
	"category": "woocommerce",
	"supports": {
		"align": false,
		"html": false,
		"multiple": false,
		"reusable": false,
		"inserter": false,
		"lock": false
	},
	"attributes": {
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": true
			}
		}
	},
	"usesContext": [ "woocommerce/cartItem", "cartKey" ],
	"parent": [ "woocommerce/cart-line-item-template" ],
	"textdomain": "woocommerce",
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
